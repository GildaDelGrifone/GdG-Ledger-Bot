# ==========================================
# Configurazione Telegram Bot
# ==========================================
# Token ottenuto da @BotFather su Telegram
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# ID della chat autorizzata (può essere un numero positivo per chat privata o negativo per gruppo/supergruppo)
# Il bot rifiuterà qualsiasi comando proveniente da altre chat!
TELEGRAM_ALLOWED_CHAT_ID=-1001234567890

# ==========================================
# Configurazione Google Sheets
# ==========================================
# Percorso del file JSON del Service Account di Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE="credentials.json"

# ID del Google Spreadsheet (presente nell'URL: https://docs.google.com/spreadsheets/d/<QUESTO_ID>/edit)
GOOGLE_SPREADSHEET_ID="inserisci_qui_id_dello_spreadsheet"

# Nome del foglio (tab) interno da utilizzare (es: "Transazioni")
GOOGLE_WORKSHEET_NAME="Transazioni"

# Imposta a "true" per testare in locale senza avere ancora le credenziali Google Sheets
USE_MOCK_SHEETS=false

# ==========================================
# Configurazione Satispay Business API
# ==========================================
# KeyId generato tramite lo script satispay_setup.py
SATISPAY_KEY_ID=""

# Percorso della chiave privata RSA generata dallo script satispay_setup.py
SATISPAY_PRIVATE_KEY_FILE="satispay_private.pem"

# Se true utilizza l'ambiente di Staging/Sandbox, se false usa la Produzione
SATISPAY_STAGING=false

# ==========================================
# Configurazione Satispay Polling & Database
# ==========================================
# Intervallo in secondi tra un controllo e l'altro dei pagamenti Satispay
SATISPAY_POLL_INTERVAL=10
SQLITE_DB_PATH="satispay_history.db"

# ==========================================
# Configurazione SumUp
# ==========================================
# Secret key API (sup_sk_...) dalla Dashboard SumUp. Se vuota, l'integrazione SumUp è disattivata
SUMUP_API_KEY=""

# Merchant code (opzionale: se vuoto viene recuperato automaticamente da /v0.1/me)
SUMUP_MERCHANT_CODE=""

# Intervallo in secondi tra un controllo e l'altro delle transazioni SumUp
SUMUP_POLL_INTERVAL=15

# Secondi massimi di attesa del pagamento durante /write
SUMUP_WAIT_TIMEOUT=300

# Se false, disattiva la generazione del QR code / link di pagamento SumUp nella chat
SUMUP_QR_ENABLED=true
